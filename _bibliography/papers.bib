  author    = {Kent, JR and Abbott, KL and Nordgren, R and Deik, A and Das, NK and Waite, M and Kunchok, T and Shevzov-Zebrun, A and Christiansen, N and Sadek, A and Bryan, DS and Ferguson, MK and Donington, JS and Muir, A and Shah, YM and Clish, CB and Vander, Heiden MG and Madariaga, MLL and Hsu, PP},
